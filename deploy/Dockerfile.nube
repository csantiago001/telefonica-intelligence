# Imagen para despliegue PERMANENTE y GRATUITO en la nube.
# - La app usa SQLite (sin reescribir nada).
# - Litestream respalda la base de datos de forma continua a Cloudflare R2
#   y la restaura al arrancar, así los datos sobreviven aunque el servidor se reinicie.
# - Los archivos de evidencia e informes se guardan directamente en R2 (STORAGE=r2).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY client/package.json client/
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 APP_MODE=private STORAGE=r2 \
    DATA_DIR=/data TRUST_PROXY=true COOKIE_SECURE=true
WORKDIR /app
# Litestream (respaldo continuo de SQLite a S3/R2)
ADD https://github.com/benbjohnson/litestream/releases/download/v0.3.13/litestream-v0.3.13-linux-amd64.deb /tmp/litestream.deb
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates /tmp/litestream.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/litestream.deb
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server ./server
COPY --from=build /app/client/dist ./client/dist
COPY --from=build /app/package.json ./
COPY deploy/litestream.yml /etc/litestream.yml
COPY deploy/arrancar-nube.sh /arrancar-nube.sh
RUN chmod +x /arrancar-nube.sh && mkdir -p /data
EXPOSE 8080
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/arrancar-nube.sh"]
