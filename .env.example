# ============================================================
# TELEFÓNICA INTELLIGENCE — Configuración (copiar a .env)
# "npm run setup" crea .env automáticamente con una clave aleatoria.
# NUNCA suba el archivo .env al repositorio.
# ============================================================

# Modo: private (uso real) | demo (datos ficticios, base separada)
APP_MODE=private

# Clave maestra de cifrado (64 caracteres hexadecimales = 256 bits).
# Cifra evidencias, informes, secretos 2FA y copias de seguridad.
# Si la pierde, NO podrá recuperar esos datos. Guárdela fuera del equipo.
MASTER_KEY=

# Red. 127.0.0.1 = solo este equipo. 0.0.0.0 = accesible desde la red local.
HOST=127.0.0.1
PORT=8080

# Carpeta de datos (base de datos, evidencias, informes, copias).
DATA_DIR=data

# URL pública HTTPS (necesaria para enviar enlaces de ubicación a otras personas).
# Ejemplo: https://ti.midominio.org
PUBLIC_URL=

# Activar solo detrás de HTTPS (proxy inverso): cookies Secure + HSTS.
COOKIE_SECURE=false
# Activar si hay un proxy inverso (Nginx, Caddy) delante de la aplicación.
TRUST_PROXY=false

# Frontend servido en otro origen (opcional). Ej.: https://panel.midominio.org
CORS_ORIGIN=

# Tamaño máximo de evidencias (MB) y tiempo de espera de fuentes OSINT (ms).
MAX_UPLOAD_MB=50
OSINT_TIMEOUT_MS=10000

# ---- Almacenamiento en la nube (opcional; para despliegue permanente) ----
# STORAGE=r2 guarda evidencias e informes en Cloudflare R2 en vez del disco local.
STORAGE=local
# Credenciales de Cloudflare R2 (solo si STORAGE=r2). NO subir con valores reales.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT y R2_REGION son opcionales (se calculan solos).
